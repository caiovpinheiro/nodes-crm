{
  "name": "n8n-nodes-eduit-crm",
  "version": "0.5.4",
  "description": "Node privado do n8n para operar o Bwipo CRM (contatos, deals, timeline, deal+contato, busca e trigger por eventos) via API com campos amigáveis.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "bwipo",
    "eduit",
    "crm"
  ],
  "license": "UNLICENSED",
  "private": true,
  "author": {
    "name": "Bwipo"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.js",
    "dev": "tsc --watch",
    "clean": "node scripts/clean.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/EduitCrmApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/EduitCrm/EduitCrm.node.js",
      "dist/nodes/EduitCrm/EduitCrmTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "n8n-workflow": "*",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
